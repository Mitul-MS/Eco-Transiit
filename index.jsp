<!DOCTYPE html>
<html>
<head>
    <title>Green Mobility</title>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <div class="container">

    <div class="card login-card">

        <h1>EcoTransit</h1>

        <h2>Student Login</h2>

        <p>Enter your details to continue.</p>

        <form action="login.jsp" method="post">

            <label>Enter your name:</label>
